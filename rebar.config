{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

{deps, [
    {telemetry, "1.3.0"}
]}.

{shell, [
    {apps, [reckon_gater]}
]}.

{profiles, [
    {test, [
        {deps, [
            {proper, "1.4.0"},
            {meck, "0.9.2"},
            {macula_testkit, "~> 0.2"}
        ]},
        {erl_opts, [debug_info, nowarn_export_all]},
        {extra_src_dirs, ["test/unit", "test/integration"]}
    ]}
    %% No `prod' profile here (removed 2026-09-05, was erl_opts-only,
    %% no relx to preserve): rebar3 merges a fetched dependency's
    %% erl_opts across EVERY profile it defines, not just whichever one
    %% the consumer actually activated. This one didn't strip
    %% debug_info (it kept it explicitly), but its `deterministic' flag
    %% still leaked into every consumer's build of reckon_gater
    %% regardless of their own choice. Same root cause as the
    %% debug_info-stripping bug found and fixed the same day on
    %% macula-io/macula, reckon-db, and reckon-gateway; this repo's own
    %% variant was milder, but not used anywhere in this repo's own
    %% CI/scripts, so nothing was lost removing it. Pass `--erl_opts
    %% +deterministic' on the command line directly if a reproducible
    %% local build is ever needed again.
]}.

%% Pinned, because a plugin in the release path is part of the release. The
%% pin lives in this file, so it is inside the tag: a plugin that breaks
%% publishing cannot be fixed by re-running the tag's job, only by cutting a
%% new version. rebar3_hex 7.3.0 (2026-09-22) reads no environment variable
%% for auth, so CI's HEX_API_KEY is ignored and publish dies on a bare
%% badmatch; 7.2.0 reads it. The others are the versions evoq 1.24.0 pins.
%% Bump one in its own commit, with the reason.
{project_plugins, [
    {rebar3_proper, "0.12.1"},
    {rebar3_ex_doc, "0.3.0"},
    {rebar3_hex, "7.2.0"},
    {rebar3_lint, "6.0.0"}
]}.

%% Elvis style rules — shared macula_min ruleset (mirrors evoq). Targets the
%% structural smells (deep nesting, nested try/catch, if-expressions) rather
%% than the full erl_files ruleset. Run via `rebar3 lint`.
{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["src/**/*.erl"], ruleset => macula_min}
    ]}
]}.

{eunit_opts, [
    verbose,
    {report, {eunit_surefire, [{dir, "_build/test/reports"}]}}
]}.

%% cth_skip_is_failure (macula_testkit): a skip nobody allowed fails the run,
%% because `rebar3 ct' exits 0 on a case that skipped itself (macula#43).
{ct_opts, [
    {dir, "test/integration"},
    {ct_hooks, [cth_skip_is_failure]}
]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.

{dialyzer, [
    {warnings, [
        unknown,
        unmatched_returns,
        error_handling,
        underspecs
    ]},
    {plt_apps, top_level_deps},
    {plt_extra_apps, [kernel, stdlib, crypto, telemetry]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

%% reckon_db_capability_verifier is an OPTIONAL RUNTIME PEER, not a dependency.
%% `reckon_gater_channel_server:do_verify_capability/3' calls
%% `verify_via(code:ensure_loaded(reckon_db_capability_verifier), ...)', and only
%% the `{module, _}' clause calls into it; the `{error, _}' clause falls back to
%% the in-repo `reckon_gater_capability:authorize/3'. Xref cannot see that guard,
%% so it reports the call as undefined. This entry says so rather than adding a
%% dependency reckon-gater must not have (it depends on nothing by design) or
%% changing code to satisfy a static check. Verified at the call site before
%% suppressing: the guard and the fallback are both there.
{xref_ignores, [
    {reckon_db_capability_verifier, authorize, 3}
]}.

%% Ex_doc configuration
{ex_doc, [
    {extras, [
        {"README.md", #{title => <<"Readme">>}},
        {"LICENSE", #{title => <<"License">>}},
        {"CHANGELOG.md", #{title => <<"Changelog">>}},
        %% Getting Started
        {"guides/configuration.md", #{title => <<"Configuration">>}},
        {"guides/event_sourcing.md", #{title => <<"Event Sourcing">>}},
        {"guides/cqrs.md", #{title => <<"CQRS">>}},
        {"guides/repl.md", #{title => <<"Interactive REPL">>}},
        %% Core Features
        {"guides/subscriptions.md", #{title => <<"Subscriptions">>}},
        {"guides/snapshots.md", #{title => <<"Snapshots">>}},
        {"guides/shared_types.md", #{title => <<"Shared Types">>}},
        {"guides/capability_security.md", #{title => <<"Capability Security">>}},
        %% Advanced
        {"guides/dcb.md", #{title => <<"Dynamic Consistency Boundary">>}},
        {"guides/ccc.md", #{title => <<"Command Context Consistency">>}},
        {"guides/temporal_queries.md", #{title => <<"Temporal Queries">>}},
        {"guides/scavenging.md", #{title => <<"Scavenging">>}},
        {"guides/causation.md", #{title => <<"Causation Tracking">>}},
        {"guides/schema_evolution.md", #{title => <<"Schema Evolution">>}},
        {"guides/stream_links.md", #{title => <<"Stream Links">>}},
        {"guides/memory_pressure.md", #{title => <<"Memory Pressure">>}},
        {"guides/telemetry.md", #{title => <<"Telemetry">>}}
    ]},
    {main, <<"README.md">>},
    {source_url, <<"https://github.com/reckon-db-org/reckon-gater">>},
    {assets, #{<<"assets">> => <<"assets">>}}
]}.

%% Hex configuration
{hex, [
    {doc, #{provider => ex_doc}}
]}.

%% Package metadata for hex.pm
{pkg, [
    {name, reckon_gater},
    {description, "Gateway for distributed access to reckon-db event stores. "
                  "Features UCAN-inspired capability tokens for decentralized "
                  "authorization, pg-based worker registry, load balancing with "
                  "exponential backoff, 10 dedicated PubSub channels, and "
                  "BEAM telemetry."},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"GitHub", "https://github.com/reckon-db-org/reckon-gater"},
        {"Docs", "https://hexdocs.pm/reckon_gater"},
        {"reckon-db", "https://github.com/reckon-db-org/reckon-db"}
    ]},
    {files, [
        "src",
        "include",
        "assets",
        "rebar.config",
        "rebar.lock",
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
        "guides"
    ]},
    {maintainers, ["Reckon-DB"]},
    {build_tools, ["rebar3"]}
]}.
